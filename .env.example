# Gmail SMTP Email Configuration Template
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=modernkris@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SENDER_EMAIL=modernkris@gmail.com

# -----------------------------------------------------------------------------
# ROBINHOOD AGENTIC TRADING CONFIGURATION (https://robinhood.com/us/en/agentic-trading/)
# -----------------------------------------------------------------------------
# Operating Environment: SANDBOX (0% Risk Simulation) or LIVE (Real Brokerage Execution)
ROBINHOOD_ENVIRONMENT=SANDBOX

# Robinhood Agentic API Credentials (obtain from Robinhood Developer Portal)
ROBINHOOD_API_KEY_ID=rh_agentic_demo_key_sandbox
ROBINHOOD_API_SECRET=rh_agentic_signing_secret_demo_key_base64
ROBINHOOD_ACCOUNT_NUMBER=RH-SIM-SANDBOX-001
ROBINHOOD_BASE_URL=https://api.robinhood.com

# Agentic Risk Guardrails (Default Settings - Configurable via UI)
# Maximum total dollar amount the AI agents can deploy across all orders per calendar day
ROBINHOOD_DAILY_SPEND_LIMIT=5000.0

# Maximum percentage of total portfolio equity that can be allocated to a single position (e.g. 15%)
ROBINHOOD_POSITION_CAP_PCT=15.0

# Emergency Kill Switch: Set to true to instantly block all automated and manual trading
ROBINHOOD_EMERGENCY_KILL_SWITCH=false

# Human-in-the-Loop: Require manual approval modal before placing live trades
ROBINHOOD_REQUIRE_HITL_CONFIRMATION=true
