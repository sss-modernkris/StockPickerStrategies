# =============================================================================
# STRATEGICALPHA / STOCKPICKERSTRATEGIES ENVIRONMENT CONFIGURATION
# =============================================================================

# Gmail SMTP Email Configuration Template
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SENDER_EMAIL=your_email@gmail.com

# -----------------------------------------------------------------------------
# ROBINHOOD AGENTIC TRADING CONFIGURATION
# -----------------------------------------------------------------------------
# Operating Mode:
#   - SANDBOX          : Internal simulation (0% risk, simulated fills against local sqlite state)
#   - LIVE_SHADOW      : Connects to Robinhood Agentic MCP for real portfolio/quotes, but simulates fills
#   - LIVE_APPROVAL    : Stages real rebalancing plans in a 15-minute TTL queue for human sign-off
#   - LIVE_AUTONOMOUS  : Autonomous real-money execution via Robinhood Agentic MCP
TRADING_MODE=SANDBOX

# Robinhood Agentic Model Context Protocol (MCP) Remote Server
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading

# Robinhood Account Pinning (Safety check: prevents placing orders on unexpected accounts)
# In SANDBOX mode, defaults to RH-SIM-SANDBOX-001
ROBINHOOD_AGENTIC_ACCOUNT_NUMBER=RH-SIM-SANDBOX-001

# Robinhood OAuth 2.1 Token Storage Path (Tokens are stored OUTSIDE the git repository)
# Defaults to %USERPROFILE%\.strategicalpha\robinhood_oauth.json
ROBINHOOD_OAUTH_TOKEN_PATH=C:\Users\username\.strategicalpha\robinhood_oauth.json

# -----------------------------------------------------------------------------
# AGENTIC RISK GATEWAY FIREWALL GUARDRAILS
# -----------------------------------------------------------------------------
# Maximum total dollar amount the AI agents can deploy across all orders per calendar day
ROBINHOOD_DAILY_SPEND_LIMIT=5000.0

# Maximum percentage of total portfolio equity that can be allocated to a single position (e.g. 15%)
ROBINHOOD_POSITION_CAP_PCT=25.0

# Emergency Kill Switch: Set to true to instantly block all automated and manual trading
ROBINHOOD_EMERGENCY_KILL_SWITCH=false

# Human-in-the-Loop requirement flag
ROBINHOOD_REQUIRE_HITL_CONFIRMATION=true

# -----------------------------------------------------------------------------
# INSTITUTIONAL LIVE EXECUTION FIREWALL THRESHOLDS
# -----------------------------------------------------------------------------
# Maximum allowable bid-ask spread percentage before rejecting a live order (default: 0.50%)
LIVE_MAX_SPREAD_PCT=0.50

# Maximum allowable price deviation from Backtester signal target price (default: 1.00%)
LIVE_MAX_SIGNAL_DEVIATION_PCT=1.00

# Safety buffer applied on limit orders (BUY: ask + buffer %, SELL: bid - buffer %)
LIVE_LIMIT_BUFFER_PCT=0.05

# Maximum seconds to wait for live order fill before canceling remaining unfilled shares
LIVE_FILL_TIMEOUT_SEC=45

# Circuit Breaker: Maximum allowable daily portfolio drawdown percentage (default: 5.00%)
LIVE_MAX_DAILY_DRAWDOWN_PCT=5.00

# Broker Rest Window (Eastern Time): Algorithmic execution is prohibited during this window
# Pipeline executes daily at 2:00 PM ET (14:00) right after the rest window closes.
BROKER_REST_START_ET=11:30
BROKER_REST_END_ET=13:55

# Strict Equities-Only policy for Live Trading (Options signals are logged as SKIPPED_LIVE_POLICY)
LIVE_EQUITIES_ONLY=true
